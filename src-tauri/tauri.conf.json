{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AsgardMU",
  "mainBinaryName": "AsgardMU",
  "version": "../package.json",
  "identifier": "br.com.asgardmu.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "AsgardMU Team",
    "shortDescription": "AsgardMU Launcher",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English", "Spanish"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
